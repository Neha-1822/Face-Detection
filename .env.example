# Workplace Monitoring - Email Alerts Configuration
# Copy this file to .env and fill in your actual credentials.

# 1. Enable Email Alerts (true/false)
ENABLE_EMAIL_ALERTS=true

# 2. Email Server Settings (Default: Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# 3. Sender Credentials
# For Gmail: Use your Gmail address and generate a 16-character App Password:
# (Google Account -> Security -> 2-Step Verification -> App Passwords)
SENDER_EMAIL=kristellardc@gmail.com
SENDER_APP_PASSWORD=your_16_char_app_password

# 4. Default Reporting Manager Email (fallback if not specified per seat in seats_3rd_floor.json)
DEFAULT_RM_EMAIL=neha@kristellar.com

# 5. Absence Limit Threshold in Seconds (Default: 600 = 10 minutes)
ABSENCE_LIMIT_SECONDS=600
